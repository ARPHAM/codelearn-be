# ============================================================
# CodeLearn Backend — Environment Variables Template
# ============================================================

# --- App Configuration ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CLIENT_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=codelearn_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Security & Authentication ---
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Redis & BullMQ ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
BULL_QUEUE_NAME=submission-queue

# --- AI Integration (Google Gemini) ---
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY_HERE
AI_HINT_RATE_LIMIT=20
AI_HINT_RATE_WINDOW_HOURS=1

# --- Code Execution (Judge0 / Docker) ---
CODE_TIMEOUT=5000
CODE_TMP_DIR=./.tmp
DOCKER_MEMORY_LIMIT=128m
DOCKER_CPU_LIMIT=0.5

# --- Security (CORS & Rate Limit) ---
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Room Management ---
ROOM_CLEANUP_INTERVAL_MINUTES=3

# --- Documentation (Swagger) ---
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=CodeLearn API
SWAGGER_VERSION=1.0
